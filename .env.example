# Google Maps Static API. Enable "Maps Static API" on the key and restrict it.
GOOGLE_MAPS_API_KEY=

# Google AI Studio / Gemini API key. Images of homes are sent to this API.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Optional. Used only with: python -m scanner.grade_roofs --push-supabase
# Use a service-role key on this trusted batch machine. Do not ship it to a browser.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_TABLE=cleared_mailout

# Address in the review dashboard. 0.0.0.0 accepts connections from the Lightsail public IP.
APP_HOST=0.0.0.0
# Port for the review dashboard. Open this TCP port in the Lightsail firewall.
APP_PORT=8080

# Scanner dashboard and marketplace. Leave the host on localhost for this PC.
# On Lightsail the public site is HTTPS, and these stay on localhost behind it.
SCANNER_HOST=127.0.0.1
SCANNER_PORT=5000

# Operator pages. When both are set, the scanner dashboard and the review page
# ask for this sign-in. The public marketplace does not.
DASHBOARD_USER=
DASHBOARD_PASSWORD=

# Optional. Months before the dashboard will scan the same address again.
# scan_config.json is used when this is blank. Default is 6.
SCAN_LOCKOUT_MONTHS=

# Marketplace invoices and "Export selected for roofer" both use this mailbox.
# The invoice email after payment includes the street addresses.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# Marketplace payments. Leave blank to use the local test payment on checkout.
# The charged amount is the listed price in cents, exclusive of GST.
# Checkout collects the buyer's details, then Stripe takes the card and issues an invoice.
STRIPE_SECRET_KEY=
# Test secret from Stripe with Test mode on (sk_test_...). Local checkout uses this and ignores a live key.
STRIPE_TEST_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Optional. Printed on the QMS Roof Scan invoice when set.
QMS_ABN=
